# =====================================================================
# SMART HEALTH MONITORING SYSTEM — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and adjust variables for your local environment.
# NEVER commit real .env files, private keys, or passwords to git.
# =====================================================================

# ---------------------------------------------------------------------
# 1. APPLICATION & SERVER SETTINGS
# ---------------------------------------------------------------------
APP_NAME="Smart Health Monitoring System"
APP_ENV=development
APP_DEBUG=true
API_HOST=127.0.0.1
API_PORT=8000
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# JSON array or comma-separated list of allowed frontend origins for CORS
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# ---------------------------------------------------------------------
# 2. MYSQL RELATIONAL DATABASE (System of Record)
# ---------------------------------------------------------------------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=smart_health
MYSQL_USER=smart_health_app
MYSQL_PASSWORD=replace_with_secure_mysql_password
MYSQL_CONNECT_TIMEOUT=10

# ---------------------------------------------------------------------
# 3. MONGODB ATLAS (DA3 Telemetry Mirror & Aggregations)
# ---------------------------------------------------------------------
# Connection URI provided by your MongoDB Atlas cluster.
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DATABASE=smart_health_analytics
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_CONNECT_TIMEOUT_MS=5000

# ---------------------------------------------------------------------
# 4. AUTHENTICATION & SECURITY (JWT & Service Keys)
# ---------------------------------------------------------------------
# Secret key used to sign JWT access tokens. Must be at least 32 characters in production.
JWT_SECRET=replace_with_min_32_char_random_secret_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Internal service-to-service key for live simulator ingestion
INGESTION_API_KEY=replace_with_simulator_service_key

# ---------------------------------------------------------------------
# 5. KAGGLE DATASET & INGESTION SETTINGS
# ---------------------------------------------------------------------
# Path to the 1,500-row Kaggle historical dataset CSV
KAGGLE_DATASET_PATH=E:\kaggle_health_dataset.csv

# Explicit source timezone assumption for Kaggle timestamps (which lack timezone offset)
DATASET_SOURCE_TIMEZONE=UTC

# ---------------------------------------------------------------------
# 6. MACHINE LEARNING & ARTIFACT SETTINGS
# ---------------------------------------------------------------------
MODEL_ARTIFACT_DIR=packages/health_analysis/artifacts
MODEL_VERSION=iforest-v1

# ==============================================================================
# SMART HEALTH MONITORING SYSTEM — ROOT ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# WARNING: Commit placeholders ONLY. Never commit actual passwords or secrets.
# ==============================================================================

# Application Environment
APP_ENV=development

# Central FastAPI Backend Gateway (Used by Doctor Web & Patient Mobile)
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000

# Backend Gateway Config (Member 1)
API_PORT=8000
INGESTION_API_KEY=replace_with_internal_ingestion_key
JWT_SECRET=replace_with_secure_jwt_secret

# Authoritative Relational Database (Member 1 — Backend only, never exposed to clients)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=smart_health
MYSQL_USER=smart_health_app
MYSQL_PASSWORD=replace_with_mysql_password

# Document Analytics Store (Member 1 / 3 — Backend only, never exposed to clients)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=smart_health_analytics

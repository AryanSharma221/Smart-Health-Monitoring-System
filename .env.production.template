# =============================================================================
# SMART HEALTH MONITORING SYSTEM — PRODUCTION ENVIRONMENT TEMPLATE
# =============================================================================
# Instructions:
# 1. Do NOT commit real production values to this repository or version control.
# 2. Supply these variables via your cloud orchestrator's secret store:
#    - Kubernetes Secrets / Helm values
#    - AWS Secrets Manager / Parameter Store
#    - Azure Key Vault / App Configuration
#    - HashiCorp Vault
# =============================================================================

# -----------------------------------------------------------------------------
# 1. APPLICATION & SERVER (Required Non-Secret Settings)
# -----------------------------------------------------------------------------
APP_NAME="Smart Health Monitoring System"
APP_ENV=production
APP_DEBUG=false
API_HOST=0.0.0.0
API_PORT=8000
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# CRITICAL: In production, configure explicit trusted frontend domains.
# Do NOT use wildcard '*' or localhost in production.
# JSON array format:
CORS_ORIGINS=["https://health.yourdomain.com", "https://portal.yourdomain.com"]

# -----------------------------------------------------------------------------
# 2. RELATIONAL SYSTEM OF RECORD (Required Secrets & Network Settings)
# -----------------------------------------------------------------------------
# MySQL 8.0+ InnoDB instance (AWS RDS, Google Cloud SQL, Azure Database for MySQL, or dedicated VM)
MYSQL_HOST=mysql-production.internal.yourdomain.com
MYSQL_PORT=3306
MYSQL_DATABASE=smart_health
MYSQL_USER=smart_health_app
# Provide a cryptographically random password (min 32 chars):
MYSQL_PASSWORD=GENERATE_HIGH_ENTROPY_PASSWORD_MIN_32_CHARS
MYSQL_CONNECT_TIMEOUT=10
MYSQL_DRIVER=mysqlconnector

# -----------------------------------------------------------------------------
# 3. MONGODB ATLAS ANALYTICS MIRROR (Optional Cloud Integration)
# -----------------------------------------------------------------------------
# Asynchronous secondary analytics mirror.
# If omitted, application operates with full clinical functionality using MySQL.
# TLS/SSL connection string from MongoDB Atlas console:
MONGODB_URI=mongodb+srv://<atlas_username>:<atlas_password>@<your-cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=smart_health_analytics
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_CONNECT_TIMEOUT_MS=5000

# -----------------------------------------------------------------------------
# 4. AUTHENTICATION & SECURITY (Required Production Secrets)
# -----------------------------------------------------------------------------
# CRITICAL: Must be a random, high-entropy secret (min 32 chars).
# Example generator: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=GENERATE_RANDOM_JWT_SIGNING_SECRET_MIN_32_CHARS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Internal service-to-service key for live telemetry simulator
INGESTION_API_KEY=GENERATE_SECURE_SIMULATOR_INGESTION_KEY

# -----------------------------------------------------------------------------
# 5. MACHINE LEARNING MODEL ARTIFACTS
# -----------------------------------------------------------------------------
MODEL_ARTIFACT_DIR=/app/packages/health_analysis/artifacts
MODEL_VERSION=iforest-v1

    "views": [
      {
        "name": "v_latest_patient_vitals",
        "sql": "CREATE VIEW v_latest_patient_vitals AS\nWITH ranked_vitals AS (\n    SELECT \n        reading_id,\n        event_id,\n        patient_id,\n        metric_code,\n        value,\n        unit,\n        raw_value,\n        raw_unit,\n        quality_status,\n        measured_at,\n        ROW_NUMBER() OVER (\n            PARTITION BY patient_id, metric_code \n            ORDER BY measured_at DESC, reading_id DESC\n        ) AS rn\n    FROM vitals_readings\n)\nSELECT \n    reading_id,\n    event_id,\n    patient_id,\n    metric_code,\n    value,\n    unit,\n    raw_value,\n    raw_unit,\n    quality_status,\n    measured_at\nFROM ranked_vitals\nWHERE rn = 1"
      },
      {
        "name": "v_patient_active_alerts",
        "sql": "CREATE VIEW v_patient_active_alerts AS\nSELECT \n    a.alert_id,\n    a.patient_id,\n    p.first_name AS patient_first_name,\n    p.last_name AS patient_last_name,\n    dpa.doctor_id,\n    a.severity,\n    a.category,\n    a.reason,\n    a.status,\n    a.created_at\nFROM alerts a\nJOIN patient_profiles p ON a.patient_id = p.patient_id\nLEFT JOIN doctor_patient_assignments dpa ON p.patient_id = dpa.patient_id AND dpa.is_active = 1\nWHERE a.status IN ('NEW', 'ACKNOWLEDGED')"
      }
    ],
    "triggers": [
      {
        "name": "trg_alert_status_history_after_update",
        "table": "alerts",
        "sql": "CREATE TRIGGER trg_alert_status_history_after_update\nAFTER UPDATE OF status ON alerts\nFOR EACH ROW\nWHEN OLD.status != NEW.status\nBEGIN\n    INSERT INTO alert_status_history (\n        alert_id, old_status, new_status, actor_id, note, changed_at\n    ) VALUES (\n        NEW.alert_id, OLD.status, NEW.status, COALESCE(NEW.acknowledged_by, NEW.resolved_by), 'Trigger recorded transition', datetime('now')\n    );\nEND"
      }
    ]
  },
